# ---------------------------------------------------------------
# Copy this file to .env and fill in your own values.
# Never commit the real .env file.
# ---------------------------------------------------------------

# Django
SECRET_KEY=replace-me-with-a-50-character-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Database
# Leave DATABASE_URL unset to use SQLite during development.
# PostgreSQL example:
# DATABASE_URL=postgres://travello:password@localhost:5432/travello

# Site metadata (used in emails, SEO tags and the sitemap)
SITE_DOMAIN=127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000

# Email — leave EMAIL_HOST blank to print verification emails to the console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Travello <hello@travello.test>

# Payments — "sandbox" simulates a successful payment with no account needed
PAYMENT_GATEWAY=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
CURRENCY=INR
CURRENCY_SYMBOL=₹
TAX_PERCENT=5

# Media storage — set to True to push uploads to Cloudinary instead of disk
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production only
SECURE_SSL_REDIRECT=True
